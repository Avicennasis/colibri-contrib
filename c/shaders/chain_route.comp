#version 450
// The router's pick on the dense chain (vk_chain.c, chain_route; vk_chain.h: vkc_route),
// every MoE engine's kind of it: one workgroup per row s < S, E <= 1024 experts, K <= 32.
//   logit e:  (l[l_off + s*l_row + e], plus bias[b_off + e] with has_bias 2) / temp
//   score:    kind 0 softmax over the row (max, exp(l - max), sum, divide: the CPU's
//             softmax_row), 1 sigmoid, 2 sqrt(softplus) (softplus = l above 20, else
//             log(1 + exp(l)): deepseek_v41.c moe_gate)
//   pick:     the score, plus bias[b_off + e] with has_bias 1 (the bias picks; the weight
//             stays the score: noaux_tc)
//   groups:   n_group > 1: E / n_group experts a group, a group's value the sum of its two
//             best picks, the topk_group best groups kept (the lower group on a tie) and
//             the pick among their experts only (qwen36.c's group-limited top-k)
//   top K:    by pick, the lower expert on a tie (every engine scans upward and keeps a
//             strictly larger value), in that rank order: ids[i_off + s*i_row + k]; a slot
//             no finite pick fills is -1
//   weights:  the K scores in rank order; norm 1: divided by their sum plus norm_eps (the
//             sum in rank order) when that is above 0 (qwen36.c), norm 2: the same from
//             K > 1 only (deepseek_v41.c); then times scale:
//             w[w_off + s*w_row + k]. A -1 slot weighs 0.
// The CPU's floats in the CPU's orders where it matters for the pick and the weights:
// exp and the sums of a softmax are the device's, so a weight can differ in its last
// bits; the ids are the CPU's unless two picks are that close.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer L { float l[]; };
layout(std430, binding = 1) readonly buffer B { float bias[]; };
layout(std430, binding = 2) buffer I { int ids[]; };
layout(std430, binding = 3) buffer W { float w[]; };

layout(push_constant) uniform P {
    int S, E, K, kind;
    int l_off, l_row, b_off, has_bias;
    int i_off, i_row, w_off, w_row;
    int n_group, topk_group, norm;
    float temp, scale, norm_eps;
} p;

const float NEG = -3.402823466e38;
shared float sc[1024];      // the scores (the weights' source)
shared float pk[1024];      // the picks; NEG out of the kept groups
shared float rv[256];
shared float gv[64];
shared int keepg[64];
shared int chosen[32];
shared float wv[32];

// Every index into shared memory is in range on every lane, the lanes a branch or a loop
// has left included: a software device (Lavapipe) reads shared memory on the inactive
// lanes too, at whatever index they hold, so a loop's index is clamped (A) and a loaded
// index is read with every lane active, clamped as well.
#define A(i) min(i, 1023)

float logit(int lb, int e) {
    float v = l[lb + e];
    if (p.has_bias == 2) v += bias[p.b_off + e];
    return v / p.temp;
}

void main() {
    int s = int(gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x);
    if (s >= p.S) return;                          // uniform across the workgroup
    int tid = int(gl_LocalInvocationID.x);
    int lb = p.l_off + s * p.l_row;

    // scores
    if (p.kind == 0) {
        float m = NEG;
        for (int e = tid; e < p.E; e += 256) m = max(m, logit(lb, e));
        rv[tid] = m;
        barrier();
        for (int off = 128; off > 0; off >>= 1) { if (tid < off) rv[tid] = max(rv[tid], rv[tid + off]); barrier(); }
        float mx = rv[0];
        barrier();
        float acc = 0.0;
        for (int e = tid; e < p.E; e += 256) { float v = exp(logit(lb, e) - mx); sc[e] = v; acc += v; }
        rv[tid] = acc;
        barrier();
        for (int off = 128; off > 0; off >>= 1) { if (tid < off) rv[tid] += rv[tid + off]; barrier(); }
        float sum = rv[0];
        barrier();
        for (int e = tid; e < p.E; e += 256) sc[e] = sc[A(e)] / sum;
    } else {
        for (int e = tid; e < p.E; e += 256) {
            float v = logit(lb, e);
            sc[e] = p.kind == 1 ? 1.0 / (1.0 + exp(-v)) : sqrt(v > 20.0 ? v : log(1.0 + exp(v)));
        }
    }
    barrier();
    for (int e = tid; e < p.E; e += 256) {
        float v = sc[A(e)];
        if (p.has_bias == 1) v += bias[p.b_off + e];   // without a bias the logits are bound here (vkc_route)
        pk[e] = isnan(v) ? NEG : v;
    }
    barrier();

    // groups: the kept groups' experts only
    if (p.n_group > 1) {
        int per = p.E / p.n_group;
        if (tid < p.n_group) {
            float b1 = NEG, b2 = NEG;
            for (int e = tid * per; e < tid * per + per; e++) {
                float v = pk[A(e)];
                if (v > b1) { b2 = b1; b1 = v; } else if (v > b2) b2 = v;
            }
            gv[tid] = b1 + b2; keepg[tid] = 0;
        }
        barrier();
        if (tid == 0)
            for (int k = 0; k < p.topk_group; k++) {
                int bg = -1; float bv = NEG;
                for (int g = 0; g < p.n_group; g++) if (keepg[g] == 0 && gv[g] > bv) { bv = gv[g]; bg = g; }
                if (bg < 0) break;
                keepg[bg] = 1;
            }
        barrier();
        for (int e = tid; e < p.E; e += 256) if (keepg[clamp(e / per, 0, p.n_group - 1)] == 0) pk[e] = NEG;
        barrier();
    }

    // top K: an expert's slot is its rank, the picks above it plus the equal ones of lower
    // experts: the order of K picks of the largest in turn, with no barrier a slot
    if (tid < p.K) chosen[tid] = -1;
    barrier();
    for (int e = tid; e < p.E; e += 256) {
        float v = pk[A(e)];
        if (!(v > NEG)) continue;
        int r = 0;
        for (int j = 0; j < p.E && r < p.K; j++) {
            float u = pk[A(j)];
            if (u > v || (u == v && j < e)) r++;
        }
        if (r < p.K) chosen[r] = e;
    }
    barrier();

    // weights, in rank order: each lane its slot's score, then every lane the same sum
    int b = chosen[min(tid, 31)];
    float v = sc[clamp(b, 0, 1023)];
    if (tid < 32) wv[tid] = b >= 0 ? v : 0.0;
    barrier();
    float sum = 0.0;
    for (int k = 0; k < p.K; k++) sum += wv[k];
    float div = sum + p.norm_eps;
    bool norm = (p.norm == 1 || (p.norm == 2 && p.K > 1)) && div > 0.0;
    if (tid < p.K) {
        float x = wv[tid];
        if (norm) x = x / div;
        ids[p.i_off + s * p.i_row + tid] = b;
        w[p.w_off + s * p.w_row + tid] = x * p.scale;
    }
}
