#version 450
// qmatmul_grp_q.comp on the matrix units (vk_chain.c, vkc_moe_rows: a prompt chunk's routed
// experts of our own formats on the dense chain): the same items, expert table, bindings
// and push constants, so the planner and the host do not change; KHR cooperative matrix
// f16 x f16 -> f32, at subgroups of 64 or 32 (the device's, required, 256 invocations).
//   y[s,o]   = sum_i x[s,i] * w[o,i]                                       (default)
//   hid[s,o] = silu(gate[s,o]) * up[s,o], clamped as expert_act.comp's act 0  (-DGATE_UP)
// An item: 32 rows of one expert and BO outputs (32 with GATE_UP, its two matrices, else
// 64), through the input in steps of 64. Half the threads decode the step's weights (32 a
// thread, of one row) times their scales to f16, the other half round the rows' inputs to
// f16, as chain_gemm.comp does; every 16 x 16 operand tile is contiguous in shared memory.
// The item's 8 accumulator tiles (2 of rows x 4 of outputs: gate 2 and up 2 with GATE_UP)
// go to the subgroups in turn. Formats: 1 int8 rows (a scale per row), 2 int4 rows, 4 int4
// with a scale per gs inputs (gs % 8 == 0); int4 nibbles as v + 8, element k at bits 4k.
// Not bit-identical to qmatmul_grp_q.comp (f16 operands). Host gates: I % 64 == 0.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(local_size_x = 256) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer WRef { uint v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer SRef { float v[]; };
layout(std430, binding = 0) readonly buffer X  { vec4 x4[]; };     // packed rows of all experts
layout(std430, binding = 1) readonly buffer IT { uvec4 items[]; };  // (expert, first row, output block, -)
layout(std430, binding = 2) readonly buffer ET { uint etab[]; };    // 16 uints per expert (qmatmul_grp.comp's)
layout(std430, binding = 3) writeonly buffer Y { float y[]; };      // packed output rows
layout(std430, binding = 4) readonly buffer AM { int amap[]; };     // kgat > 0: qmatmul_grp.comp's
layout(push_constant) uniform P { int I, O; float limit; int ibase; int kgat; int rpw; } p;

#define TM 32u
#ifdef GATE_UP
#define BO 32u
#else
#define BO 64u
#endif
#define TK 64u
// tile (a, kt) of 16 x 16 halves at (a * 4 + kt) * 32 uvec4s, element (row, k) at row * 16 + k
shared uvec4 sx[2u * 4u * 32u];    // the rows' inputs: 2 row tiles
shared uvec4 sw[4u * 4u * 32u];    // the weights: 4 output tiles (gate 0-1, up 2-3 with GATE_UP)
shared float sacc[8u * 256u];      // the accumulators, tile by tile, for the epilogue

uint pk(float a, float b) { return packFloat2x16(f16vec2(float16_t(a), float16_t(b))); }
// an activation operand: held to +-65504 (a value past it would round to inf and the tile's
// sums with it; the CUDA f16 GEMMs hold x the same way), a NaN kept a NaN. The weights, a
// format's codes times its scales, stay well inside f16 and skip it (the hold on them cost
// Qwen3.6's prompt 4%)
float h16(float a) { return isnan(a) ? a : clamp(a, -65504.0, 65504.0); }
uint pkx(float a, float b) { return pk(h16(a), h16(b)); }

// row o's weights k..k+31 (fmt 1: eight words of int8, else four of int4) times their scales,
// as f16 into output tile q's row r, k tiles kt0 and kt0 + 1
void put_row(WRef w, SRef sc, uint fmt, uint rowWords, uint gs, uint o, uint k, uint K, uint q, uint r, uint kt0) {
    uint base = o * rowWords, e0 = (q * 4u + kt0) * 32u + r * 2u;
    if (fmt == 1u) {
        float s = sc.v[o];
        [[unroll]] for (uint j = 0u; j < 8u; j += 2u) {   // two words = 8 values = one uvec4
            uint a = w.v[base + k / 4u + j], b = w.v[base + k / 4u + j + 1u];
            vec4 fa = vec4(float(int(a << 24) >> 24), float(int(a << 16) >> 24), float(int(a << 8) >> 24), float(int(a) >> 24)) * s;
            vec4 fb = vec4(float(int(b << 24) >> 24), float(int(b << 16) >> 24), float(int(b << 8) >> 24), float(int(b) >> 24)) * s;
            sw[e0 + (j >> 2u) * 32u + ((j >> 1u) & 1u)] = uvec4(pk(fa.x, fa.y), pk(fa.z, fa.w), pk(fb.x, fb.y), pk(fb.z, fb.w));
        }
        return;
    }
    uint ng = (K + gs - 1u) / max(gs, 1u);
    [[unroll]] for (uint j = 0u; j < 4u; j++) {           // one word = 8 nibbles = one uvec4
        uint v = w.v[base + k / 8u + j];
        float s = fmt == 4u ? sc.v[o * ng + (k + 8u * j) / gs] : sc.v[o];
        vec4 lo = (vec4(float(v & 15u), float((v >> 4) & 15u), float((v >> 8) & 15u), float((v >> 12) & 15u)) - 8.0) * s;
        vec4 hi = (vec4(float((v >> 16) & 15u), float((v >> 20) & 15u), float((v >> 24) & 15u), float(v >> 28)) - 8.0) * s;
        sw[e0 + (j >> 1u) * 32u + (j & 1u)] = uvec4(pk(lo.x, lo.y), pk(lo.z, lo.w), pk(hi.x, hi.y), pk(hi.z, hi.w));
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x, nsg = gl_NumSubgroups, sgi = gl_SubgroupID;
    uvec4 it = items[uint(p.ibase) + gl_WorkGroupID.x];
    uint eb = it.x * 16u;
    WRef gw = WRef(uvec2(etab[eb + 0u], etab[eb + 1u])); SRef gsc = SRef(uvec2(etab[eb + 2u], etab[eb + 3u]));
#ifdef GATE_UP
    WRef uw = WRef(uvec2(etab[eb + 4u], etab[eb + 5u])); SRef usc = SRef(uvec2(etab[eb + 6u], etab[eb + 7u]));
#endif
    uint S = etab[eb + 8u], xoff = etab[eb + 9u], fmt = etab[eb + 10u], rowWords = etab[eb + 11u], gs = etab[eb + 12u];
    uint s0 = it.y, o0 = it.z * BO, K = uint(p.I), O = uint(p.O);

    // accumulator tile c = sgi + j * nsg: rows tile c & 1, outputs tile c >> 1
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[2];
    [[unroll]] for (uint j = 0u; j < 2u; j++) acc[j] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> A;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> B;
    uint nc = 8u / nsg;   // tiles per subgroup: 1 (eight of 32) or 2 (four of 64)

    for (uint k0 = 0u; k0 < K; k0 += TK) {
        barrier();   // the last step is read
        if (tid < 128u) {   // decode: (matrix,) row, which of the step's two 32-weight halves
            uint h = tid & 1u;
#ifdef GATE_UP
            bool up = (tid >> 6) != 0u; uint r = (tid >> 1) & 31u;
            WRef w = up ? uw : gw; SRef sc = up ? usc : gsc;
            uint q = (up ? 2u : 0u) + (r >> 4u);
#else
            uint r = tid >> 1;
            WRef w = gw; SRef sc = gsc;
            uint q = r >> 4u;
#endif
            uint o = min(o0 + r, O - 1u);
            put_row(w, sc, fmt, rowWords, gs, o, k0 + 32u * h, K, q, r & 15u, 2u * h);
        } else {            // the rows' inputs: 32 x 64 values, 8 a uvec4, two a thread
            [[unroll]] for (uint e = tid - 128u; e < TM * TK / 8u; e += 128u) {
                uint r = e / (TK / 8u), c8 = e - r * (TK / 8u), k = c8 * 8u;
                bool ok = s0 + r < S;
                uint xr = xoff + s0 + min(r, S - 1u - s0);
#ifdef GATE_UP
                if (p.kgat > 0) xr = uint(amap[xr]) / uint(p.kgat);
#endif
                vec4 a = vec4(0.0), b = vec4(0.0);
                if (ok) { uint i4 = (xr * K + k0 + k) / 4u; a = x4[i4]; b = x4[i4 + 1u]; }
                sx[((r >> 4u) * 4u + (k >> 4u)) * 32u + (r & 15u) * 2u + ((k & 15u) >> 3u)] =
                    uvec4(pkx(a.x, a.y), pkx(a.z, a.w), pkx(b.x, b.y), pkx(b.z, b.w));
            }
        }
        barrier();
        [[unroll]] for (uint j = 0u; j < 2u; j++) {
            if (j >= nc) break;   // subgroup-uniform
            uint c = sgi + j * nsg, t = c & 1u, q = c >> 1u;
            [[unroll]] for (uint kt = 0u; kt < 4u; kt++) {
                coopMatLoad(A, sx, (t * 4u + kt) * 32u, 2u, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(B, sw, (q * 4u + kt) * 32u, 2u, gl_CooperativeMatrixLayoutColumnMajor);
                acc[j] = coopMatMulAdd(A, B, acc[j]);
            }
        }
    }
    [[unroll]] for (uint j = 0u; j < 2u; j++) {
        if (j >= nc) break;
        coopMatStore(acc[j], sacc, (sgi + j * nsg) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    }
    barrier();
#ifdef GATE_UP
    for (uint e = tid; e < TM * BO; e += 256u) {
        uint r = e / BO, n = e - r * BO, s = s0 + r, o = o0 + n;
        if (s >= S || o >= O) continue;
        uint t = r >> 4u, at = (r & 15u) * 16u + (n & 15u);
        float g = sacc[(((n >> 4u)) * 2u + t) * 256u + at], u = sacc[((2u + (n >> 4u)) * 2u + t) * 256u + at];
        if (p.limit > 0.0) { if (g > p.limit) g = p.limit; if (u > p.limit) u = p.limit; if (u < -p.limit) u = -p.limit; }
        y[(xoff + s) * O + o] = (g / (1.0 + exp(-g))) * u;
    }
#else
    for (uint e = tid; e < TM * BO; e += 256u) {
        uint r = e / BO, n = e - r * BO, s = s0 + r, o = o0 + n;
        if (s >= S || o >= O) continue;
        uint yr = xoff + s;
        if (p.kgat > 0) yr = uint(amap[yr]);
        y[yr * O + o] = sacc[((n >> 4u) * 2u + (r >> 4u)) * 256u + (r & 15u) * 16u + (n & 15u)];
    }
#endif
}
