+def _hf_headers(extra=None):
+    """Headers for huggingface.co resolve requests. Attaches HF_TOKEN so gated
+    repos (e.g. Bahushruth/GLM-5.2-FP8-abliterated) download through the raw
+    urllib path used by download_retry / --mtp / --indexer, not only via
+    huggingface_hub. Token: HF_TOKEN or HUGGING_FACE_HUB_TOKEN."""
+    h = {"User-Agent": "colibri-convert"}
+    t = os.environ.get("HF_TOKEN") or os.environ.get("HUGGING_FACE_HUB_TOKEN")
+    if t:
+        h["Authorization"] = f"Bearer {t}"
+    if extra:
+        h.update(extra)
+    return h
